{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tajul",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/worker.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE",
        "class_name": "SiteStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SiteStore"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}